<% layout ('/layouts/boilerplate') -%>
<body>
    <h3>Todo of per Id</h3>
    <ul>
        <li><%= list.title %></li>
    </ul>  
    <br>
    <a href="/listings/<%=list._id%>/edit ">Edit todo information</a> 
    <br>
    <br>
    <form method="POST" action="/listings/<%= list._id %>?_method=DELETE">
        <button style="background-color: #f44336; color: white; padding: 10px 20px; border: none; cursor: pointer;">Delete todo</button>
    </form>
</body>