<% layout ('/layouts/boilerplate') -%>
<body>
    <h3>Edit your listing</h3>
    <form method="POST" action="/listings/<%= list._id %>?_method=PUT">
        <input type="text" name="listing[title]" value="<%= list.title %>" required />
        <br><br>
        <button style="background-color: #4CAF50; color: white; padding: 10px 20px; border: none; cursor: pointer;">Update Your Todo</button>
        <br>
    </form>
</body>
