<% layout ('/layouts/boilerplate') -%>
<body>
  <h3>Create new listing</h3>
  <form method="POST" action="/listings">
    <input
      type="text"
      name="listing[title]"
      placeholder="Enter your todo"
      required
    />
    <br /><br />
    <button
      style="
        background-color: #4caf50;
        color: white;
        padding: 10px 20px;
        border: none;
        cursor: pointer;
      "
    >
      Add
    </button>
    <br />
  </form>
</body>
